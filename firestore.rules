rules_version = '2';

// Splitr security rules
//
// Data layout:
//   users/{uid}                          own profile + contacts
//   groups/{gid}                         members[], admins[], memberNames{}, participants[]
//   groups/{gid}/expenses/{id}
//   groups/{gid}/settlements/{id}
//
// Model: the group code is the invite. Any signed-in user can look up a group
// by its exact code and add themselves; everything inside a group (expenses,
// settlements) is visible to members only. Admins manage the group.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function groupAt(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }

    // Older groups have no `admins` field: the creator is the admin.
    function adminsOf(g) {
      return g.get('admins', []).size() > 0 ? g.admins : [g.get('createdBy', '')];
    }

    function isMemberOf(g) {
      return signedIn() && request.auth.uid in g.members;
    }

    function isAdminOf(g) {
      return isMemberOf(g) && request.auth.uid in adminsOf(g);
    }

    // Admins can delete group data; so can the last remaining member.
    function canPurge(g) {
      return isAdminOf(g) || (isMemberOf(g) && g.members.size() == 1);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Only my own entry in the memberNames map changed (or the map is untouched).
    function onlyMyNameChanged() {
      return !('memberNames' in changedKeys())
        || request.resource.data.memberNames
             .diff(resource.data.get('memberNames', {}))
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    // Claiming a name-only placeholder ("that's me"): exactly one new entry,
    // pointing at me, for an id that isn't a member, and I hold no claim yet.
    // Removing or reassigning claims is admin-only (admin path below).
    function claimOk() {
      let before = resource.data.get('claims', {});
      let after = request.resource.data.get('claims', {});
      let d = after.diff(before);
      return !('claims' in changedKeys())
        || (d.addedKeys().size() == 1
          && d.changedKeys().size() == 0
          && d.removedKeys().size() == 0
          && !(request.auth.uid in before.values())
          // with no earlier claim of mine, the one new value must be me
          && after.values().removeAll(before.values()) == [request.auth.uid]
          && !d.addedKeys().hasAny(resource.data.members));
    }

    function validName(s, max) {
      return s is string && s.size() > 0 && s.size() <= max;
    }

    // Exactly these fields, no more (stops junk that every member would download).
    function hasExactly(keys) {
      return request.resource.data.keys().hasOnly(keys)
        && request.resource.data.keys().hasAll(keys);
    }

    // Positive, below 100M, and in whole cents (shares themselves are checked
    // by the app: rules can't sum a list).
    function validMoney(n) {
      return n is number && n > 0 && n < 100000000
        && math.abs(n * 100 - math.round(n * 100)) < 0.001;
    }

    // ── Users ───────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ── Groups ──────────────────────────────────────────────────────────────

    match /groups/{gid} {
      // Look up by exact code (needed to join). Listing returns only my groups.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      // `create` only applies when the doc doesn't exist yet, so a code
      // collision can never overwrite someone else's group.
      allow create: if signedIn()
        && gid.size() >= 4 && gid.size() <= 12
        && request.resource.data.keys().hasOnly(
             ['id', 'name', 'members', 'participants', 'createdBy', 'admins', 'memberNames', 'createdAt'])
        && validName(request.resource.data.name, 100)
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('participants', []).size() <= 50;

      allow update: if signedIn() && (
        // Admins: rename, manage admins/members/participants.
        (isAdminOf(resource.data)
          && changedKeys().hasOnly(['name', 'admins', 'members', 'participants', 'memberNames', 'claims'])
          && validName(request.resource.data.name, 100)
          && request.resource.data.admins.size() > 0
          && request.resource.data.members.hasAll(request.resource.data.admins)
          && request.resource.data.get('participants', []).size() <= 50)

        // Joining with the code: add only myself (my display name, and
        // optionally my claim on a placeholder).
        || (!(request.auth.uid in resource.data.members)
          && changedKeys().hasOnly(['members', 'memberNames', 'claims'])
          && claimOk()
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && onlyMyNameChanged())

        // Leaving (non-admin): remove only myself.
        || (isMemberOf(resource.data)
          && changedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet()
               == resource.data.members.toSet().difference([request.auth.uid].toSet()))

        // Any member: claim a placeholder as me.
        || (isMemberOf(resource.data)
          && changedKeys().hasOnly(['claims'])
          && claimOk())

        // Any member: update my own display name.
        || (isMemberOf(resource.data)
          && changedKeys().hasOnly(['memberNames'])
          && onlyMyNameChanged())
      );

      allow delete: if canPurge(resource.data);

      // ── Expenses ──────────────────────────────────────────────────────────
      match /expenses/{expenseId} {
        allow read: if isMemberOf(groupAt(gid));

        allow create: if isMemberOf(groupAt(gid))
          && hasExactly(['id', 'groupId', 'description', 'amount', 'paidBy', 'splits', 'createdBy', 'createdAt'])
          && request.resource.data.id == expenseId
          && request.resource.data.groupId == gid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is string
          && validName(request.resource.data.description, 200)
          && validMoney(request.resource.data.amount)
          && validName(request.resource.data.paidBy, 128)
          && request.resource.data.splits is list
          && request.resource.data.splits.size() > 0
          && request.resource.data.splits.size() <= 100;

        // Expenses are immutable; admins remove wrong ones.
        allow update: if false;
        allow delete: if canPurge(groupAt(gid));
      }

      // ── Settlement payments ───────────────────────────────────────────────
      match /settlements/{settlementId} {
        allow read: if isMemberOf(groupAt(gid));

        allow create: if isMemberOf(groupAt(gid))
          && hasExactly(['id', 'groupId', 'from', 'to', 'amount', 'recordedBy', 'createdAt'])
          && request.resource.data.id == settlementId
          && request.resource.data.groupId == gid
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.createdAt is string
          && validName(request.resource.data.from, 128)
          && validName(request.resource.data.to, 128)
          && request.resource.data.from != request.resource.data.to
          && validMoney(request.resource.data.amount);

        allow update: if false;
        allow delete: if canPurge(groupAt(gid));
      }
    }

    // Everything else is closed.
  }
}
