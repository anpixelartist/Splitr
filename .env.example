# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# Leave them empty to run in local-only mode (no sync, no sharing).
#
# These values are not secrets — they ship inside the web app. Security comes
# from firestore.rules, not from hiding these.

VITE_FIREBASE_API_KEY=
# Tip: after deploying, set this to your hosting domain (e.g. my-splitr.web.app)
# so Google sign-in works in Safari / iPhone home-screen apps. See DEPLOYMENT.md.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
